{
    // Mostra / e /storage lado a lado (as duas % juntas na barra).
    // Clique → notificação com o detalhe separado (tamanhos). Hover idem.
    // Backend: ~/.local/bin/disk-usage.sh (lê df dos dois mountpoints).
    "custom/disk": {
        "exec": "disk-usage.sh",
        "return-type": "json",
        "interval": 30,
        "on-click": "disk-usage.sh --notify",
        "tooltip": true
    },

    "memory": {
        "tooltip": false,
        "interval": 5,
        "format": "󰍛 <span size='11pt'>{used:0.1f}G</span>",
        "format-alt": "󰍛 <span size='11pt'>{percentage}%</span>",
        "states": { "warning": 75, "critical": 90 }
    }
}
