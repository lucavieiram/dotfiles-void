{
    "clock": {
        "timezone": "America/Sao_Paulo",
        "format":     "󰃰 <span size='11pt'>{:%H:%M}</span>",
        "format-alt": "󰃰 <span size='11pt'>{:%d %b %Y}</span>",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": { "mode": "month", "weeks-pos": "right", "on-scroll": 1 }
    }
}
