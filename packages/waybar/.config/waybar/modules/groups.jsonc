{
    "group/distro-group": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": true
        },
        "modules": [
            "custom/distro",
            "custom/terminal",
            "custom/editor",
            "custom/files",
            "custom/obsidian",
            "custom/browser"
        ]
    },

    "group/storage": {
        "orientation": "horizontal",
        "modules": ["custom/disk", "memory"]
    },

    "group/system": {
        "orientation": "horizontal",
        "modules": ["temperature", "cpu"]
    },

    "group/audio": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "transition-left-to-right": false
        },
        "modules": [
            "pulseaudio",
            "pulseaudio/slider",
            "pulseaudio#microphone"
        ]
    },

    "group/connections": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 400,
            "transition-left-to-right": false,
            "click-to-reveal": true
        },
        "modules": ["network", "bluetooth"]
    },

    "group/tray-group": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 400,
            "transition-left-to-right": false,
            "click-to-reveal": true
        },
        "modules": ["custom/tray-arrow", "tray"]
    }
}
