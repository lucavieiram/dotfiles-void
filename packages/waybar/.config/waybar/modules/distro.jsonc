        "format": "",
        "on-click": "footclient -e nvim",
        "tooltip": false
    },
    "custom/files": {
        "format": "󰪶",
        "on-click": "footclient -e yazi",
        "tooltip": false
    },
    "custom/obsidian": {
        "format": "",
        "on-click": "obsidian",
        "tooltip": false
    },
    "custom/browser": {
        "format": "󰈹",
