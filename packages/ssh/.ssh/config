# ~/.ssh/config — hardened defaults + per-host overrides
# Private keys live OUTSIDE this repo — never commit ~/.ssh/id_*

# Real hosts (private IPs/users) live in ~/.ssh/config.local, which is NOT
# versioned — keep infra-specific entries there, not in this template.
Include ~/.ssh/config.local

Host *
    # Security defaults
    HashKnownHosts          yes
    StrictHostKeyChecking   ask
    UpdateHostKeys          yes
    VerifyHostKeyDNS        no
    UseRoaming              no                # CVE-2016-0777 / 0778 mitigation

    # Crypto preferences (modern only)
    HostKeyAlgorithms       ssh-ed25519,ssh-ed25519-cert-v01@openssh.com,rsa-sha2-512,rsa-sha2-256
    KexAlgorithms           curve25519-sha256@libssh.org,curve25519-sha256,diffie-hellman-group16-sha512
    MACs                    hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,umac-128-etm@openssh.com
    Ciphers                 chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com

    # Identity / agent
    IdentitiesOnly          yes
    AddKeysToAgent          yes
    # No global IdentityFile on purpose: with IdentitiesOnly, naming a key that
    # does not exist makes every connection print "no such identity", which
    # buries the real error when auth actually fails. Each Host block in
    # ~/.ssh/config.local names its own key.

    # Connection
    ServerAliveInterval     60
    ServerAliveCountMax     3
    Compression             no
    ControlMaster           auto
    ControlPath             ~/.ssh/sockets/%r@%h:%p
    ControlPersist          30m

# ── Per-host examples (real entries go in ~/.ssh/config.local) ────
#
# Host myserver
#     HostName     <tailscale-magicdns-name>
#     User         <user>
#     IdentityFile ~/.ssh/<key-for-that-host>
#
# Host github.com
#     HostName github.com
#     User     git
#     IdentityFile ~/.ssh/id_ed25519_github
